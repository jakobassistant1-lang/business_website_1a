    "next": "^15.5.19",
    "pdf-parse": "^2.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.9"

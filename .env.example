# Copy to .env and fill in. Do NOT commit your real .env.

# PostgreSQL connection string (e.g. Neon). For local dev you can point this at a
# Neon dev branch or a local Postgres. Used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Comma-separated emails that get admin access to the team board (/admin).
ADMIN_EMAILS=""

# Invite code for self-service signup. If empty/unset, public signup is CLOSED
# (accounts are created via `npm run create-user`). Set a value to allow people
# who have the code to register.
SIGNUP_INVITE_CODE=""

# Google Gemini API key for the AI "daily briefing" (server-only, never exposed
# to the client). If unset, the Plan page still renders the full plan + the
# deterministic priority recommendations — only the AI sentence is skipped.
GEMINI_API_KEY=""

# Google Calendar OAuth (Connections tab). All server-only. If unset, the
# "Connect Google Calendar" card shows "not available yet" and nothing breaks.
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# (OAuth client, type "Web application"). The redirect URI must EXACTLY match.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain/api/connections/google/callback"

# "Sign in with Google" on the login page (lib/googleAuth.ts) — a SEPARATE OAuth
# client from the calendar one above, so login only needs the non-sensitive
# openid/email/profile scopes. ALL THREE must be set or the "Continue with Google"
# button is hidden (isGoogleAuthConfigured() returns false) and the feature looks
# like it does nothing. Create a second "Web application" OAuth client and add its
# redirect URI below EXACTLY (note the path is /api/auth/google/callback, different
# from the calendar callback). For local dev use http://localhost:3000/api/auth/google/callback.
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="https://your-domain/api/auth/google/callback"

# Encrypts OAuth tokens at rest (AES-256-GCM). Any long random string. If unset,
# tokens are stored in plaintext (dev only — set this in production).
ENCRYPTION_KEY=""

# Transactional email (Resend) — powers the "forgot password" reset link.
# Create an API key at resend.com and verify your sending domain (add the SPF +
# DKIM DNS records Resend shows). EMAIL_FROM must be an address on that verified
# domain. If EITHER is unset, NO email is sent — the reset link is logged to the
# server console instead (handy in dev; never leave unset in production).
RESEND_API_KEY=""
EMAIL_FROM="StudyPlan <noreply@pinnavel.com>"

# Canonical public origin for links in emails (the password-reset link). Set this
# in production (e.g. https://pinnavel.com) so reset links are NEVER built from the
# request's Host header (spoofable → reset-link poisoning). If unset, it falls back
# to GOOGLE_AUTH_REDIRECT_URI's origin, then Vercel's VERCEL_PROJECT_PRODUCTION_URL,
# then the request origin (dev only).
APP_URL=""

# Stripe billing (lib/billing.ts). Inert until set — billing/paywall stay
# completely OFF without these (isBillingConfigured() returns false, hasActiveAccess
# is true for everyone, the /billing page redirects away, the account Subscription
# section is hidden, and the billing API routes 404). ALL THREE of SECRET_KEY,
# PRICE_ID, and WEBHOOK_SECRET must be set to turn billing on.
# Get keys at dashboard.stripe.com → Developers → API keys. PRICE_ID is the price
# on your product (Products → your product → pricing, starts "price_"). WEBHOOK_SECRET
# (starts "whsec_") comes from Developers → Webhooks → your endpoint
# (point it at /api/billing/webhook). Use test-mode keys in dev.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Optional. Human-readable price shown on the trial card, e.g. "$8/month".
# Falls back to "your plan" if unset.
STRIPE_PRICE_DISPLAY=""
# Optional. Where Stripe's billing portal sends the user back to. Falls back to
# the app's /account page if unset.
STRIPE_PORTAL_RETURN_URL=""

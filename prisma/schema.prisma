// StudyPlan data model (PRD §8).
// Passwords are bcrypt-hashed (see lib/password.ts). NOTE: the Canvas API token
// is still stored in plaintext — acceptable for a trusted-team deploy, but
// encrypt-at-rest is a recommended follow-up before wider exposure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  fullName           String
  phone              String?
  // Gates the admin-only team Kanban board (see lib/admin.ts). Defaults false;
  // the ADMIN_EMAILS env allowlist can also grant admin without setting this.
  isAdmin            Boolean  @default(false)
  tosAcceptedAt      DateTime
  defaultHoursPerDay Float    @default(3)
  planningWindowDays Int      @default(7)
  defaultEffortHours Float    @default(2)
  createdAt          DateTime @default(now())

  sessions      Session[]
  credential    CanvasCredential?
  courses       Course[]
  assignments   Assignment[]
  announcements Announcement[]
  adminTasks    AdminTask[]
}

// Internal team task board (admin-only). Not user-facing and unrelated to
// Canvas coursework — this is how the owner + team track building the business.
model AdminTask {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("todo") // "todo" | "progress" | "review" | "done"
  position    Int       @default(0) // order within a column
  // New card fields — all optional, so existing cards are unaffected (additive).
  dueDate     DateTime?
  category    String? // free-form category tag
  ticketSize  String? // "small" | "medium" | "large" (validated in app)
  contributor String? // free-text contributor (name or initials); shown as initials
  // Nullable + SetNull: the board is shared by the team, so a task must outlive
  // the account that created it (deleting an admin nulls the author, not the task).
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, position])
}

model Session {
  token     String   @id
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CanvasCredential {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  host                 String
  apiBase              String
  token                String
  accountName          String?
  lastValidatedAt      DateTime?
  lastValidationStatus String?
  syncedAt             DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id       Int    @id @default(autoincrement())
  userId   Int
  canvasId Int
  name     String

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  announcements Announcement[]

  // Canvas IDs are unique per user, not globally — two users in the same
  // institution can share a course canvasId (multi-user scaling).
  @@unique([userId, canvasId])
}

model Assignment {
  id              Int       @id @default(autoincrement())
  userId          Int
  canvasId        Int
  courseId        Int
  courseCanvasId  Int
  name            String
  dueAt           DateTime?
  pointsPossible  Float?
  htmlUrl         String?
  updatedAt       DateTime  @updatedAt
  // Submission data from Canvas include[]=submission (canvas-mcp integration)
  submittedAt     DateTime?
  submissionScore Float?
  submissionState String?   // "submitted" | "graded" | "unsubmitted" | "pending_review"

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasId])
}

model Announcement {
  id             Int       @id @default(autoincrement())
  userId         Int
  canvasId       Int
  courseId       Int
  courseCanvasId Int
  title          String
  message        String?
  postedAt       DateTime?
  htmlUrl        String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasId])
}

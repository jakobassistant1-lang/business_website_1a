// StudyPlan data model (PRD §8).
// Passwords are bcrypt-hashed (see lib/password.ts). The Canvas API token and
// Google OAuth tokens are encrypted at rest via lib/crypto.ts (AES-256-GCM when
// ENCRYPTION_KEY is set; tagged-plaintext safe fallback otherwise).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  // Null for accounts created via "Sign in with Google" (passwordless).
  password           String?
  fullName           String
  phone              String?
  // Gates the admin-only team Kanban board (see lib/admin.ts). Defaults false;
  // the ADMIN_EMAILS env allowlist can also grant admin without setting this.
  isAdmin            Boolean  @default(false)
  tosAcceptedAt      DateTime
  defaultHoursPerDay Float    @default(3)
  planningWindowDays Int      @default(7) // fixed at 7 in code; column kept for back-compat
  defaultEffortHours Float    @default(2) // internal fallback when Gemini hasn't estimated effort
  studyDaysTest      Int      @default(7) // days ahead to start studying for exams/tests
  studyDaysQuiz      Int      @default(3) // days ahead to start studying for quizzes
  studyDaysFinal     Int      @default(14) // days ahead to start studying for midterms/finals (cumulative)
  createdAt          DateTime @default(now())
  // When the student finished (or skipped) the first-run demo. Defaults to now()
  // so EXISTING users (backfilled when this column is added) and seeded/admin
  // accounts skip it; the signup paths set it to NULL so genuinely new students
  // get the demo (null → routed to /demo on first entry; set on finish/skip).
  onboardedAt        DateTime? @default(now())

  sessions      Session[]
  credential    CanvasCredential?
  courses       Course[]
  assignments   Assignment[]
  announcements Announcement[]
  adminTasks    AdminTask[]
  googleCalendar GoogleCalendarConnection?
  googleEvents   GoogleCalendarEvent[]
  studyGenerations StudyGeneration[]
  passwordResetTokens PasswordResetToken[]
  studentNotes  StudentNote[]
  notionConnection NotionConnection?
}

// Single-use, time-limited password-reset tokens (the "forgot password" flow).
// Only the sha256 HASH of the token is stored — the raw token lives solely in the
// emailed link — so a database leak can't be used to reset anyone's password.
// Consumed on use (usedAt) and expired after 1h (see lib/passwordReset.ts).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cached AI study artifacts (study-plan layer / study guide / practice questions),
// one row per user × assessment × kind (× question type), so repeat visits cost
// ZERO model calls. inputHash fingerprints the generation inputs (linked Canvas
// material, schedule blocks, prompt version); a mismatch on revalidation means
// the source changed → regenerate. content is a JSON payload (shape per kind).
model StudyGeneration {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId     Int // the assessment's Assignment.canvasId
  kind         String // "plan" | "guide" | "questions"
  questionType String   @default("") // kind=questions: "multiple_choice" | "true_false" | "short_answer"; "" otherwise
  content      String // JSON
  inputHash    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, canvasId, kind, questionType])
}

// Internal team task board (admin-only). Not user-facing and unrelated to
// Canvas coursework — this is how the owner + team track building the business.
model AdminTask {
  id          Int       @id @default(autoincrement())
  // Which board this card belongs to: "build" (the StudyPlan MVP backlog) or
  // "marketing" (launch/marketing work). Same columns + card shape, separate lane.
  board       String    @default("build")
  title       String
  description String?
  status      String    @default("todo") // "backlog" | "todo" | "doing" | "done"
  position    Int       @default(0) // order within a column
  // New card fields — all optional, so existing cards are unaffected (additive).
  dueDate     DateTime?
  category    String? // free-form category tag
  ticketSize  String? // "small" | "medium" | "large" (validated in app) → points 1/2/3
  contributor String? // free-text contributor (name or initials); shown as initials
  // Backlog/hierarchy fields (StudyPlan MVP backlog). All optional/additive.
  ticketNumber Int?     // build number within a board (1..N); null = ad-hoc (multiple NULLs allowed)
  goal        String? // top of the hierarchy, e.g. "AHA #1 — Clarity"
  subgoal     String? // mid level, e.g. "1A — Foundation"
  acceptance  String? // acceptance criteria text
  dependencies String? // free-text deps, e.g. "1, 2"
  completedAt DateTime? // set when the card first reaches "done" — powers the burndown
  // Nullable + SetNull: the board is shared by the team, so a task must outlive
  // the account that created it (deleting an admin nulls the author, not the task).
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Build numbering is per-board, so the same #1 can exist on each board.
  @@unique([board, ticketNumber])
  @@index([board, status, position])
}

// Global app settings (key/value). Currently holds the editable Gemini briefing
// prompt (key "briefing_prompt"); admin-editable via /admin/ai.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// --- Google Calendar integration (fully isolated from Canvas; see lib/googleCalendar) ---
// Tokens are stored encrypted at rest when ENCRYPTION_KEY is set (lib/crypto.ts).
model GoogleCalendarConnection {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  email        String? // the connected Google account
  accessToken  String? // encrypted
  refreshToken String? // encrypted
  expiresAt    DateTime? // access-token expiry
  scope        String?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events GoogleCalendarEvent[]
}

model GoogleCalendarEvent {
  id            Int      @id @default(autoincrement())
  userId        Int
  connectionId  Int
  googleEventId String
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean  @default(false) // all-day events are skipped by the planner's busy-time calc
  location      String?
  source        String   @default("google")
  updatedAt     DateTime @updatedAt

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, startTime])
}

model Session {
  token     String   @id
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CanvasCredential {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  host                 String
  apiBase              String
  token                String
  accountName          String?
  lastValidatedAt      DateTime?
  lastValidationStatus String?
  syncedAt             DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id       Int    @id @default(autoincrement())
  userId   Int
  canvasId Int
  name     String
  // v1 prioritizer signals + the student's own Canvas course total
  // (include[]=total_scores). All nullable → fail open. currentScore 0–100;
  // currentGrade letter. Null = instructor hides totals OR nothing graded yet
  // (lib/courseGrade tells those apart from the work, so we never guess).
  currentScore    Float?
  currentGrade    String?
  latePolicyKind  String? // "none" | "flat" | "perday" (Gemini-parsed from the syllabus)
  latePolicyValue Float?  // fraction of credit lost (flat: one-time; perday: per day)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  announcements Announcement[]

  // Canvas IDs are unique per user, not globally — two users in the same
  // institution can share a course canvasId (multi-user scaling).
  @@unique([userId, canvasId])
}

model Assignment {
  id              Int       @id @default(autoincrement())
  userId          Int
  canvasId        Int
  courseId        Int
  courseCanvasId  Int
  name            String
  dueAt           DateTime?
  pointsPossible  Float?
  htmlUrl         String?
  submissionType  String?   // Canvas submission_types, comma-joined (e.g. "online_quiz") — drives the Calendar TYPE glyph
  studyLeadDays   Int?      // per-assignment override of days-ahead to study (null = use the User default by type)
  effortOverrideHours Float? // per-user manual override of the AI effort estimate (null = use the AI estimate); feeds display + scheduling
  // Student manually checked this off (null = not checked). Feeds the ONE done
  // rule (lib/assignmentStatus): manual check OR Canvas submission counts as done.
  // Never written by Canvas sync, so a sync can't un-check it.
  manualDoneAt    DateTime?
  updatedAt       DateTime  @updatedAt
  // Submission data from Canvas include[]=submission (canvas-mcp integration)
  submittedAt     DateTime?
  submissionScore Float?
  submissionState String?   // "submitted" | "graded" | "unsubmitted" | "pending_review"

  // Assignment-group (Canvas grade category) + its weight — powers the weighted
  // grade calculator. All null when ungrouped or the course is points-based; the
  // calculator falls back to raw points in that case (fail-open).
  groupId         Int?
  groupName       String?
  groupWeight     Float?    // Canvas assignment_group.group_weight (percent)

  // Canvas body + AI analysis (lib/analysis.ts). All nullable: null effort/summary
  // means "not analyzed yet" → scheduler uses the flat default, UI shows no summary.
  description          String?
  estimatedEffortHours Float?
  effortBucket         String?   // "quick" | "medium" | "long"
  aiImportance         Int?      // 1-5 AI importance/difficulty → weights the planner's time allocation
  aiSummary            String?
  // v1 prioritizer: false = passive / teacher-graded (participation, attendance,
  // placeholder column) → excluded from the ordering; null or true = keep (the
  // default — readings + in-person exams stay). Set by the Gemini analysis.
  aiRequiresAction     Boolean?
  // Precomputed share of the course grade (0–1) for weighted-group courses; null
  // → caller falls back to points / course-total. See lib/gradeWeight.
  gradeWeight          Float?
  analysisHash         String?   // sha1 of the analyzed inputs (for re-analysis detection)
  analyzedAt           DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasId])
}

model Announcement {
  id             Int       @id @default(autoincrement())
  userId         Int
  canvasId       Int
  courseId       Int
  courseCanvasId Int
  title          String
  message        String?
  postedAt       DateTime?
  htmlUrl        String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasId])
}

// Student-uploaded study notes for ONE assessment (per-test scope). Only the
// EXTRACTED TEXT is stored — never the original file (text-only by design). These
// are fed into study-guide / practice-question generation as PINNED sources:
// always included, ordered ahead of Canvas material, and exempt from the AI
// relevance filter (see lib/study.ts collectStudyMaterial / relevanceFilter).
// sourceKind drives the UI badge; imageCount > 0 marks photo notes (handwriting
// transcribed by Gemini vision in Phase 2).
model StudentNote {
  id         Int      @id @default(autoincrement())
  userId     Int
  canvasId   Int // the Assignment.canvasId this note supports
  title      String
  sourceKind String // "paste" | "pdf" | "docx" | "text" | "image" | "notion"
  text       String // extracted text — the only thing persisted
  charCount  Int      @default(0)
  imageCount Int      @default(0) // photo notes: number of source images (else 0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, canvasId])
}

// A student's connected Notion workspace (OAuth). Notion access tokens are
// long-lived (no refresh token / expiry), so this is simpler than the Google
// connection. The token is encrypted at rest (lib/crypto). Used to search the
// pages the integration was granted and import them as student notes.
model NotionConnection {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  accessToken   String // encrypted
  workspaceName String?
  workspaceId   String?
  botId         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
